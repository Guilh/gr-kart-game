{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm run sim:check)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsx scripts/*)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * main)",
      "Bash(vercel * --prod*)",
      "Bash(vercel --prod*)",
      "Bash(vercel promote *)",
      "Bash(vercel rollback *)",
      "Bash(vercel remove *)",
      "Bash(vercel rm *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-release.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
